<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TomatoLock · 番茄熟成计划" Width="1080" Height="780" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#FFF8ED" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#44392C">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#44392C"/><Setter Property="BorderBrush" Value="#EADBC5"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#EADBC5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="BorderBrush" Value="#EADBC5"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Window.Resources>
  <Grid Background="#FFF8ED">
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#294A37"><DockPanel Margin="22,30,14,24">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="● TomatoLock" FontSize="21" FontWeight="Bold" Foreground="#F7F4E8"/><TextBlock Text="留一点时间，给自己。" Foreground="#B8CCC0" FontSize="12" Margin="2,10,0,38"/>
        <Button x:Name="NavFocus" Content="◷   专注计时" Background="#DCE9CD" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavHistory" Content="▤   时长与日报" Background="#365D43" Foreground="White" BorderThickness="0"/>
        <Button x:Name="NavAchievements" Content="☆   成就收藏" Background="#365D43" Foreground="White" BorderThickness="0"/>
        <Button x:Name="NavSettings" Content="⚙   偏好设置" Background="#365D43" Foreground="White" BorderThickness="0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="LOCAL FIRST" Foreground="#B8CCC0" FontSize="11"/><TextBlock Text="离线可用 · 数据留在本机" Foreground="#B8CCC0" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="v1.1.0  /  Windows" Foreground="#8EAD9D" FontSize="11" Margin="0,7,0,0"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="30,24,30,16">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="今天，种点好事情" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="把待办慢慢煮熟，把时间还给自己。" Foreground="#897B67" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="LocalClock" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#897B67" FontSize="12" TextAlignment="Right"/></Grid>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="FocusPage" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Padding="24" Background="#FFFCF6"><StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#FFF4E4" CornerRadius="24" Margin="0,0,22,0"><Image x:Name="HeroTomato" Height="188" Margin="8" Stretch="Uniform"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="F O C U S  &amp;  G R O W" FontSize="11" Foreground="#B17B51" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="SessionLabel" Text="今天，种下一颗专注番茄" HorizontalAlignment="Center" Foreground="#897B67"/>
                <TextBlock x:Name="Countdown" Text="45:00" FontFamily="Segoe UI" FontSize="68" FontWeight="SemiBold" Foreground="#CE4B33" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="EndEstimate" Text="准备好了，就开始吧" HorizontalAlignment="Center" Foreground="#897B67" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ProgressBar x:Name="TimerProgress" Minimum="0" Maximum="100" Height="6" BorderThickness="0" Background="#EFE3D0" Foreground="#D94E36" Margin="0,0,0,20"/>
            <WrapPanel x:Name="Presets" HorizontalAlignment="Center"><Button Content="10 分钟" Tag="10"/><Button Content="25 分钟" Tag="25"/><Button Content="45 分钟" Tag="45" Background="#FFE2CF"/><Button Content="60 分钟" Tag="60"/><Button Content="100 分钟" Tag="100"/></WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="自定义" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="CustomMinutes" Text="45" Width="86"/><TextBlock Text="分钟（1–720）" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
            <Button x:Name="StartButton" Content="种下这颗番茄" Background="#D94E36" Foreground="White" BorderThickness="0" FontSize="17" FontWeight="SemiBold" Padding="44,13" HorizontalAlignment="Center" Margin="0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="专注期间，可使用" FontWeight="SemiBold"/><TextBlock Text="ChatGPT 桌面客户端 · WPS Office · 本地文件" Foreground="#60756A" Margin="0,7,0,12"/>
            <WrapPanel><Button x:Name="OpenChat" Content="打开 ChatGPT"/><Button x:Name="OpenWps" Content="打开 WPS"/><Button x:Name="OpenFile" Content="阅读本地文件"/><Button x:Name="OpenFolder" Content="打开本地文件夹"/></WrapPanel>
            <TextBlock Text="提前结束：同时按住 Esc + Ctrl + Delete + Shift，保持 1 秒。" Foreground="#6F7D72" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <TextBlock x:Name="TodaySummary" Foreground="#897B67" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="Totals" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="完整完成计入成就；提前解锁和意外退出保留实际时长。" Foreground="#897B67" Margin="0,8,0,16" TextWrapping="Wrap"/><WrapPanel><DatePicker x:Name="ReportDate" Width="150" Margin="0,0,12,10"/><Button x:Name="MakeReport" Content="生成 / 刷新日报"/><Button x:Name="ReportsFolder" Content="日报文件夹"/></WrapPanel><StackPanel x:Name="UsageRows"/></StackPanel></Border>
          <StackPanel x:Name="HistoryRows"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="AchievementsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Border Background="#F4E9D4" CornerRadius="14" Padding="18,13" Margin="0,0,12,18"><DockPanel><TextBlock x:Name="CollectionCount" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/><TextBlock Text="解锁后永久收藏 · 每颗都有点脾气" FontSize="12" Foreground="#897B67" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
          <WrapPanel x:Name="AchievementRows"/>
          <TextBlock Text="应用成就只读取自愿开启的活跃时长统计；烂番茄只计算主动四键解锁。" FontSize="12" TextWrapping="Wrap" Foreground="#897B67" Margin="0,8,0,12"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="番茄的声音" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="专注完成与成就解锁时播放短旋律；烂番茄有自己的下行小调。" TextWrapping="Wrap" Foreground="#897B67" Margin="0,8,0,0"/><CheckBox x:Name="MuteSounds" Content="关闭完成与成就音效（保存后生效）"/><Button x:Name="PreviewSound" Content="♫  试听解锁旋律" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="允许的桌面应用" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="第一次使用，请先打开 ChatGPT 和 WPS，再点自动识别。只信任你确认的程序完整路径和文件指纹；应用更新后需重新确认。" TextWrapping="Wrap" Foreground="#897B67" Margin="0,8,0,12"/><WrapPanel><Button x:Name="DiscoverApps" Content="自动识别应用"/><Button x:Name="AddApp" Content="手动选择程序"/></WrapPanel><StackPanel x:Name="AllowedRows"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="可选的使用统计" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="TrackApps" Content="我同意在后台统计前台应用的活跃时长"/><CheckBox x:Name="TrackSites" Content="我同意读取浏览器地址栏，并仅保存域名与时长"/><TextBlock Text="网站识别适配 Chrome / Edge / Firefox，也尝试兼容 Brave / Vivaldi / Opera。读取失败标为“未识别网站”。不保存完整 URL、标题、搜索词或页面内容；隐私窗口若能读取地址栏，也会被统计。" TextWrapping="Wrap" Foreground="#897B67" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="无输入超过" VerticalAlignment="Center"/><TextBox x:Name="IdleLimit" Text="180" Width="72" Margin="10,0"/><TextBlock Text="秒后排除统计（30–3600）" VerticalAlignment="Center"/></StackPanel>
          <CheckBox x:Name="Startup" Content="我同意开机自启（登录 Windows 后，最小化到托盘）"/><TextBlock Text="默认均关闭。退出程序后不统计；跨日自动生成 Markdown 与 CSV 日报，下次启动补生成未运行期间已有记录的日报。" TextWrapping="Wrap" Foreground="#897B67" FontSize="12"/><Button x:Name="SaveSettings" Content="保存偏好" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="使用边界与数据" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="这是应用级自律工具，不能封锁 Windows 安全桌面、管理员权限、重启或强制结束进程。专注中 Esc 保留给解锁组合，不会传给其他应用。文件浏览器仅放行本地磁盘位置；ChatGPT / WPS 自身的联网功能仍可使用。后台音视频不会自动停止。" TextWrapping="Wrap" Foreground="#897B67" Margin="0,10,0,12"/><WrapPanel><Button x:Name="DataFolder" Content="打开数据文件夹"/><Button x:Name="ClearUsage" Content="删除应用 / 网站统计"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#EADBC5" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="就绪 · 记录保存在本机" Foreground="#62786B" FontSize="12" TextWrapping="Wrap"/></Border>
      <Border x:Name="AchievementToast" Grid.RowSpan="3" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="410" Background="#FFF5DE" BorderBrush="#DEA366" BorderThickness="2" CornerRadius="18" Padding="14" Margin="0,0,0,42" Panel.ZIndex="10">
        <DockPanel><Button x:Name="CloseAchievement" DockPanel.Dock="Right" Content="×" VerticalAlignment="Top" Padding="7,2" Margin="6,0,0,0"/><Image x:Name="ToastImage" DockPanel.Dock="Left" Width="78" Height="78" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="ToastDescription" FontSize="12" Foreground="#897B67" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
